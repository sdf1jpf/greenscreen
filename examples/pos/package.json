{
  "name": "greenscreen-pos",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --var DEV_USER:cashier1 --var MANAGERS:cashier1",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply greenscreen-pos --local",
    "db:migrate:remote": "wrangler d1 migrations apply greenscreen-pos --remote",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@greenscreen-dev/web": "*",
    "@greenscreen-dev/worker": "*",
    "hono": "^4.13.14"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261025.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12",
    "wrangler": "^4.152.0"
  }
}
