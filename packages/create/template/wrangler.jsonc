{
	"name": "__NAME__",
	"main": "src/index.ts",
	"compatibility_date": "2026-10-01",
	// The browser terminal. Files there are served as assets; /v1/... reaches
	// the Worker.
	"assets": { "directory": "node_modules/@greenscreen-dev/web/public" }
