{
  "name": "@greenscreen-dev/worker",
  "version": "0.3.0",
  "description": "Serve 3270-style screens from a Cloudflare Worker",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./sessions": {
      "types": "./dist/sessions.d.ts",
      "default": "./dist/sessions.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "hono": "^4.13.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261025.1",
    "hono": "^4.13.14",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sdf1jpf/greenscreen.git",
    "directory": "packages/worker"
  },
  "publishConfig": {
    "access": "public"
  }
}
